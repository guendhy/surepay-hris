# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables (separately for Preview and Production).
# Never commit real values.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy "service_role" key. SERVER ONLY.
# Used for cron jobs, the email queue and sending invitations.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Single sign-on button on the login page: google | azure | none
NEXT_PUBLIC_SSO_PROVIDER=none

# --- Field encryption (government IDs, bank accounts) -------------------------
# 32 random bytes, base64. Generate with:  npm run gen:key
# Use a DIFFERENT key per environment. Losing it makes stored IDs unreadable —
# keep a copy in the company password vault.
FIELD_ENCRYPTION_KEY=

# --- Scheduled jobs (Vercel Cron sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=

# --- Email (optional locally; without it only in-app notifications are sent) --
RESEND_API_KEY=
EMAIL_FROM="Surepay HRIS <hris@your-company-domain>"

# --- Demo data script (npm run seed:demo) — local/staging only ---------------
DEMO_PASSWORD=
# Set to "yes" to allow seeding a non-local Supabase project (staging only).
ALLOW_REMOTE_DEMO_SEED=
