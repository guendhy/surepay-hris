# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables (separately for Preview and Production).
# Never commit real values.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy "service_role" key. SERVER ONLY.
# Used for cron jobs, the email queue and sending invitations.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Single sign-on button on the login page: google | azure | none
NEXT_PUBLIC_SSO_PROVIDER=none

# --- Field encryption (government IDs, bank accounts) -------------------------
# 32 random bytes, base64. Generate with:  npm run gen:key
# Use a DIFFERENT key per environment. Losing it makes stored IDs unreadable —
# keep a copy in the company password vault.
FIELD_ENCRYPTION_KEY=

# --- Scheduled jobs (Vercel Cron sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=

# --- Email: app notifications over SMTP (Mailtrap) ----------------------------
# Without these, only in-app notifications are sent.
# Mailtrap Email TESTING (sandbox — emails land in your Mailtrap inbox, never
# reach real people; use for local/staging):
#   SMTP_HOST=sandbox.smtp.mailtrap.io   SMTP_PORT=2525
#   SMTP_USER / SMTP_PASS = Inbox → Integration → SMTP credentials
# Mailtrap Email SENDING (real delivery; needs a verified domain; production):
#   SMTP_HOST=live.smtp.mailtrap.io      SMTP_PORT=587
#   SMTP_USER / SMTP_PASS = Sending Domains → your domain → Integration → SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be an address on your verified Mailtrap sending domain (for Email Sending).
EMAIL_FROM="Surepay HRIS <hris@your-company-domain>"

# --- Supabase Auth emails (invitations, password resets) ----------------------
# "true" once custom SMTP (the same Mailtrap credentials) is saved in Supabase:
# Authentication → Emails → SMTP Settings. Leave "false" and HR creates
# one-time invite / reset links to send to employees themselves.
AUTH_EMAILS_ENABLED=false

# --- Demo data script (npm run seed:demo) — local/staging only ---------------
DEMO_PASSWORD=
# Set to "yes" to allow seeding a non-local Supabase project (staging only).
ALLOW_REMOTE_DEMO_SEED=
